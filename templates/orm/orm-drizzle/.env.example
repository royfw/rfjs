# drizzle-kit `generate` binds enum types and FK targets to `public.`, so the
# connection string must resolve migrations against the `public` schema (the
# default). Do NOT add `?options=-csearch_path=<other>` unless your tables are
# defined with drizzle `pgSchema()` bound to that same schema.
DATABASE_URL="postgresql://user:password@localhost:5432/db"
