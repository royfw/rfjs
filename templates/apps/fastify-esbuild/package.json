{
  "name": "fastify-esbuild",
  "version": "0.0.0",
  "description": "A project created by starter-ts-fastify",
  "private": true,
  "scripts": {
    "clean": "pnpm exec rimraf ./dist",
    "dev": "pnpm exec cross-env NODE_OPTIONS=--enable-source-maps pnpm run dev:esbuild",
    "dev:esbuild": "pnpm exec cross-env NODE_ENV=local pnpm exec npm-run-all --parallel build:esbuild:watch typecheck:watch",
    "start": "pnpm exec cross-env NODE_OPTIONS=--enable-source-maps node dist/main.js",
    "start:watch": "pnpm exec nodemon --ext js --exec \"node dist/main.js\"",
    "build": "pnpm run build:esbuild",
    "build:esbuild": "pnpm run clean && pnpm exec tsx esbuild.build.ts",
    "build:esbuild:watch": "pnpm run clean && pnpm exec tsx esbuild.dev.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "pnpm run vitest:run",
    "vitest:run": "vitest --passWithNoTests --run",
    "vitest:ui": "vitest --passWithNoTests --ui",
    "commit": "pnpm exec cz",
    "prepare": "pnpm exec husky",
    "preinstall": "pnpm exec only-allow pnpm",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "_moduleAliases": {
    "@": "./dist"
  },
  "lint-staged": {
    "*.ts": [
      "pnpm exec vitest related --run",
      "pnpm exec prettier --write",
      "pnpm exec eslint --fix"
    ]
  },
  "keywords": [],
  "author": "Roy Chuang",
  "license": "ISC",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=10.24.0 <11.0.0"
  },
  "files": [
    "dist/**"
  ],
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@commitlint/cz-commitlint": "^19.6.1",
    "@eslint/js": "^9.20.0",
    "@rfjs/tpl-toolkit": "^0.0.4",
    "@types/dotenv-flow": "^3.3.3",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-istanbul": "^3.2.3",
    "@vitest/ui": "^3.2.3",
    "commitizen": "^4.3.1",
    "cross-env": "*",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.25.2",
    "esbuild-plugin-tsc": "^0.5.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "nodemon": "^3.1.0",
    "npm-run-all": "^4.1.5",
    "only-allow": "^1.2.2",
    "prettier": "^3.5.1",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsc-watch": "^6.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitepress": "^1.6.3",
    "vitest": "^3.2.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.5",
    "dotenv-flow": "^4.1.0",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "pino-pretty": "^13.1.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
