{
  "name": "docs-vitepress",
  "version": "0.0.0",
  "description": "A project created by docs-vitepress",
  "scripts": {
    "clean": "pnpm exec rimraf ./dist",
    "build": "pnpm run build:esbuild",
    "dev": "pnpm run dev:esbuild",
    "dev:esbuild": "NODE_ENV=local pnpm run clean && pnpm exec npm-run-all --parallel build:esbuild:watch",
    "dev:rollup": "NODE_ENV=local pnpm run clean && pnpm exec npm-run-all --parallel build:rollup:watch",
    "start": "node dist/main.js",
    "start:watch": "pnpm exec nodemon --ext js --exec \"node dist/main.js\"",
    "build:esbuild": "pnpm run clean && node esbuild.build.mjs",
    "build:esbuild:watch": "pnpm run clean && node esbuild.dev.mjs",
    "build:rollup": "pnpm run clean && rollup -c",
    "build:rollup:watch": "pnpm run clean && rollup -c -w",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "pnpm run vitest:run",
    "vitest:run": "vitest --passWithNoTests --run",
    "vitest:ui": "vitest --passWithNoTests --ui",
    "prepare": "pnpm exec husky",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "_moduleAliases": {
    "@": "./dist"
  },
  "lint-staged": {
    "*.ts": [
      "pnpm exec prettier --write",
      "pnpm exec eslint --fix"
    ]
  },
  "keywords": [],
  "author": "Roy Chuang",
  "license": "ISC",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=10.24.0 <11.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@commitlint/cz-commitlint": "^19.6.1",
    "@eslint/js": "^9.20.0",
    "@rfjs/tpl-toolkit": "^0.0.2-alpha.0",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/dotenv-flow": "^3.3.3",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-istanbul": "^3.2.3",
    "@vitest/ui": "^3.2.3",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.25.2",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "nodemon": "^3.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.36.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsc-watch": "^6.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitepress": "^1.6.3",
    "vitest": "^3.2.3"
  },
  "dependencies": {
    "dotenv-flow": "^4.1.0",
    "module-alias": "^2.2.3"
  }
}
